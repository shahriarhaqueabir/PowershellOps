# .gitignore — PowershellOps

# ─────────────────────────────────────────────
# AGENT INTERNAL STATE (Private reasoning/plans)
# ─────────────────────────────────────────────
.memory/
plans/
docs/superpowers/

# ─────────────────────────────────────────────
# LOCAL DATA & USER CONFIG
# ─────────────────────────────────────────────
Memory/
Reports/
Config/
testResults.xml
ops-test-results.xml
.Ops_first_run

# ─────────────────────────────────────────────
# VECTORS & MODELS (Stored locally)
# ─────────────────────────────────────────────
# Keep modelfiles/ folder but ignore specific local bin/weights if any
# modelfiles/

# ─────────────────────────────────────────────
# IDE & OS METADATA
# ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# ─────────────────────────────────────────────
# POWERSHELL / BUILD ARTIFACTS
# ─────────────────────────────────────────────
Help/
Scripts/dev/
BackupOriginal/
__final_check.ps1
*.backup.ps1
*.bak
*.old
*.tmp
*.temp
*.log

# ─────────────────────────────────────────────
# MODULE DEPENDENCIES
# Use Install-OpsPrerequisite to populate Modules/
# ─────────────────────────────────────────────
Modules/*/
!Modules/PowershellOps/

# ─────────────────────────────────────────────
# SECRETS (STRICT PROHIBITION)
# ─────────────────────────────────────────────
*.key
*.pem
*.pfx
*.crt
*.p12
.env
.env.*
secrets.*
credentials.*

# ─────────────────────────────────────────────
# WHITELIST (Explicitly tracked assets)
# ─────────────────────────────────────────────
!Modules/PowershellOps/Patterns/
!docs/*.md
