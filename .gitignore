# Hawkward Hybrid — .gitignore

# Build artifacts
*.log
hawk-install.log
hawk-tests.log

# Staging / temp
hawk-stage-*/
*.tmp
*.temp

# User config (generated on install)
hawk.config.json

# Reports (generated at runtime)
Reports/

# llama.cpp runtime
llama-app/
llama-server.exe
llama.exe

# Model files (downloaded on install)
Models/
*.gguf

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# PowerShell module cache
__pycache__/
*.pyc

# Test artifacts
TestResults/
*.trx

# Local agent context / caches (not part of the product)
.context/
.opencode/
build/